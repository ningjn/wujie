{
  "name": "wujie-project",
  "version": "0.0.0",
  "description": "极致的微前端框架",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  },
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider lerna run start --parallel",
    "doc": "lerna run docs:dev",
    "clean": "rimraf node_modules **/*/node_modules",
    "test": "NODE_OPTIONS=--openssl-legacy-provider lerna run test --scope wujie",
    "commitlint": "commitlint -E COMMIT_EDITMSG_PATH",
    "husky-commitlint": "commitlint -e",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "author": "yiludege",
  "license": "MIT",
  "lint-staged": {
    "packages/wujie-core/src/**/*.ts": "./packages/wujie-core/node_modules/.bin/eslint --fix --ext .ts --config packages/wujie-core/.eslintrc.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@lerna-lite/cli": "^1.17.0",
    "@lerna-lite/run": "^1.17.0",
    "husky": "^7.0.4",
    "lint-staged": "^12.5.0",
    "rimraf": "^3.0.2"
  }
}
