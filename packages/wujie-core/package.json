{
  "name": "wujie",
  "version": "2.1.0",
  "description": "极致的微前端框架",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "files": [
    "lib",
    "esm"
  ],
  "scripts": {
    "lib": "webpack build --config webpack.config.js",
    "esm": "cross-env BABEL_ENV=esm babel ./src --out-dir ./esm --extensions .ts --source-maps && tsc --emitDeclarationOnly",
    "prepack": "bash build.sh",
    "start": "cross-env BABEL_ENV=esm babel ./src --out-dir ./esm --extensions .ts --source-maps inline --watch & tsc --emitDeclarationOnly",
    "lint": "eslint --ext .ts ./src --fix",
    "test": "npm run test:unit && NODE_OPTIONS=--openssl-legacy-provider npm run test:integration",
    "test:unit": "jest -c __test__/unit/jest.config.js",
    "kill-integration-ports": "node scripts/kill-integration-ports.js",
    "install-puppeteer-browser": "node ./node_modules/puppeteer/install.js",
    "test:integration": "npm run install-puppeteer-browser && npm run kill-integration-ports && NODE_OPTIONS=--openssl-legacy-provider jest -c __test__/integration/jest.config.js --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "author": "yiludege",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^27.5.2",
    "@types/jest-environment-puppeteer": "^5.0.6",
    "@types/node": "18.19.130",
    "@types/puppeteer": "^5.4.7",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "babel-jest": "^27.5.1",
    "babel-loader": "8.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-promise": "^5.2.0",
    "jest": "^27.5.1",
    "jest-puppeteer": "^6.2.0",
    "prettier": "^2.8.8",
    "puppeteer": "^14.4.1",
    "sass-loader": "^12.6.0",
    "ts-jest": "^27.1.5",
    "typescript": "^4.9.5",
    "webpack": "5.112.2",
    "webpack-cli": "^4.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "eslintIgnore": [
    "*.js"
  ],
  "dependencies": {
    "@babel/runtime": "^7.29.10"
  }
}
